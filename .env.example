# Copia este archivo a .env (raíz). api y agents lo leen desde aquí.
# Con los valores por defecto TODO corre en modo mock: no necesitas llaves para empezar.

# ─── Flags de respaldo ──────────────────────────────────────────────
# MOCK_OP=1 simula Open Payments. SOLO para desarrollar. NUNCA en la demo.
MOCK_OP=1
MOCK_SMS=1
MOCK_LLM=1
MOCK_INVENTORY_PAYMENT=0

# ─── URLs ───────────────────────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001
AGENTS_URL=http://localhost:8000
WEB_URL=http://localhost:5173
# URL pública (ngrok / cloudflared) que llega a la api. Se usa para /callback y Twilio.
PUBLIC_API_URL=http://localhost:3001

# ─── Open Payments (Test Wallet: https://wallet.interledger-test.dev) ─
# Wallet cliente de Paygent (la que firma las requests)
OP_CLIENT_WALLET=https://ilp.interledger-test.dev/agentpay
OP_KEY_ID=
OP_PRIVATE_KEY_PATH=./private.key
# En Railway no hay fichero: pega aquí el contenido de private.key (PEM o base64). Tiene prioridad sobre la ruta.
OP_PRIVATE_KEY=

# ─── Base de datos ──────────────────────────────────────────────────
# Postgres. En Railway: ${{Postgres.DATABASE_URL}}. Vacío = PGlite (Postgres embebido) en src/api/.data/pglite,
# sin instalar nada. Las wallets de quien delega y de los comercios, los agentes y las cuentas viven en la base:
# se dan de alta por la api (POST /merchants, POST /agents), no con variables de entorno.
DATABASE_URL=

# Tasa COP/USD: la api trae la TRM del día (datos.gov.co). FX_COP_PER_USD es el respaldo si no hay red;
# MOCK_FX=1 no la consulta y usa siempre el respaldo.
FX_COP_PER_USD=4000
MOCK_FX=0

# ─── Agentes ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_TIMEOUT_S=8
# Tope de cada respuesta SMS del Asistente (306 = 2 segmentos GSM-7; se corta en una frase completa)
SMS_MAX_CHARS=306
# Credencial única del servicio de agentes ante la api (la misma en api y agents). Cada agente es una fila de la
# tabla agents y se indica con el header x-agent-id: dar de alta uno no añade variables.
AGENT_SERVICE_KEY=dev-agents-key
# Firma los tokens de sesión. Vacío: se deriva de la llave del gateway (guardada en la base). En prod, un secreto aleatorio.
SESSION_SECRET=

# ─── SMS por Telnyx (POST /sms/telnyx) ──────────────────────────────
# twiml = solo /sms/inbound (celular simulado, puente adb) · smsgate = además el webhook de SMS Gateway for Android · telnyx = el de Telnyx
SMS_PROVIDER=twiml
# Llave de API (Portal → API Keys). Con MOCK_SMS=1 no se envía nada a Telnyx.
TELNYX_API_KEY=
# Llave pública ed25519 para verificar los webhooks (Portal → Keys & Credentials → Public Key)
TELNYX_PUBLIC_KEY=
# Número Telnyx que envía las respuestas (E.164) y su perfil de mensajería (opcional)
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=

# ─── SMS por SMS Gateway for Android (POST /sms/smsgate) ────────────
# Un Android con SIM colombiana es el número, por su propio internet. Usuario y contraseña: app → Cloud server.
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# App → Settings → Webhooks → Signing Key (verifica cada webhook)
SMSGATE_SIGNING_KEY=
# Vacío = la nube (https://api.sms-gate.app/3rdparty/v1)
SMSGATE_API_URL=

# ─── Puente SMS con tu celular Android (pnpm sms:bridge) ───────────
# Solo se reenvían estos números (coma). Nunca pongas códigos cortos: el puente los ignora igual.
SMS_BRIDGE_ALLOW=
# Número real = número sembrado en la demo, para hablar como Doña Carmen sin resembrar.
SMS_BRIDGE_ALIAS=
# api a la que se reenvía (producción: https://paygent.up.railway.app/api)
SMS_BRIDGE_API=http://localhost:3001
SMS_BRIDGE_POLL_MS=3000
# SIM que envía (defaultSmsSubId en `adb shell dumpsys isub`) y código isms (8 en Android 14–16)
SMS_BRIDGE_SUB_ID=1
SMS_BRIDGE_ISMS_CODE=8
ADB_PATH=adb
ADB_SERIAL=
