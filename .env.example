# Copia este archivo a .env (raíz). api y agents lo leen desde aquí.
# Con los valores por defecto TODO corre en modo mock: no necesitas llaves para empezar.

# ─── Flags de respaldo ──────────────────────────────────────────────
# MOCK_OP=1 simula Open Payments. SOLO para desarrollar. NUNCA en la demo.
MOCK_OP=1
MOCK_SMS=1
MOCK_LLM=1
MOCK_INVENTORY_PAYMENT=0

# ─── URLs ───────────────────────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001
AGENTS_URL=http://localhost:8000
WEB_URL=http://localhost:5173
# URL pública (ngrok / cloudflared) que llega a la api. Se usa para /callback y Twilio.
PUBLIC_API_URL=http://localhost:3001

# ─── Open Payments (Test Wallet: https://wallet.interledger-test.dev) ─
# Wallet cliente de Paygent (la que firma las requests)
OP_CLIENT_WALLET=https://ilp.interledger-test.dev/agentpay
OP_KEY_ID=
OP_PRIVATE_KEY_PATH=./private.key
# En Railway no hay fichero: pega aquí el contenido de private.key (PEM o base64). Tiene prioridad sobre la ruta.
OP_PRIVATE_KEY=

# ─── Base de datos ──────────────────────────────────────────────────
# Postgres. En Railway: ${{Postgres.DATABASE_URL}}. Vacío = PGlite (Postgres embebido) en src/api/.data/pglite,
# sin instalar nada. Las wallets de quien delega y de los comercios, los agentes y las cuentas viven en la base:
# se dan de alta por la api (POST /merchants, POST /agents), no con variables de entorno.
DATABASE_URL=

# Tasa de referencia (OP-10). Simulada, se muestra con etiqueta en la UI.
FX_COP_PER_USD=4000

# ─── Agentes ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_TIMEOUT_S=8
# Credencial única del servicio de agentes ante la api (la misma en api y agents). Cada agente es una fila de la
# tabla agents y se indica con el header x-agent-id: dar de alta uno no añade variables.
AGENT_SERVICE_KEY=dev-agents-key
