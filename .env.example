# Copia este archivo a .env (raíz). api y agents lo leen desde aquí.
# Con los valores por defecto TODO corre en modo mock: no necesitas llaves para empezar.

# ─── Flags de respaldo ──────────────────────────────────────────────
# MOCK_OP=1 simula Open Payments. SOLO para desarrollar. NUNCA en la demo.
MOCK_OP=1
MOCK_SMS=1
MOCK_LLM=1
MOCK_INVENTORY_PAYMENT=0

# ─── URLs ───────────────────────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001
AGENTS_URL=http://localhost:8000
WEB_URL=http://localhost:5173
# URL pública (ngrok / cloudflared) que llega a la api. Se usa para /callback y Twilio.
PUBLIC_API_URL=http://localhost:3001

# ─── Open Payments (Test Wallet: https://wallet.interledger-test.dev) ─
# Wallet cliente de OpenRoute (la que firma las requests)
OP_CLIENT_WALLET=https://ilp.interledger-test.dev/openroute
OP_KEY_ID=
OP_PRIVATE_KEY_PATH=./private.key

# Wallets de la demo (PRE-01)
WALLET_JUAN=https://ilp.interledger-test.dev/juan
WALLET_TIENDA=https://ilp.interledger-test.dev/dona-rosa
WALLET_FARMACIA=https://ilp.interledger-test.dev/farmacia-san-jose
WALLET_PUNTORED=https://ilp.interledger-test.dev/puntored-efectivo
WALLET_INVENTARIO=https://ilp.interledger-test.dev/agente-inventario

# Tasa de referencia (OP-10). Simulada, se muestra con etiqueta en la UI.
FX_COP_PER_USD=4000

# ─── Agentes ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_TIMEOUT_S=8
# API keys de los agentes hacia la api (BE-AUTH alternativa P0)
AGENT_KEY_ASSISTANT=dev-assistant-key
AGENT_KEY_GUARDIAN=dev-guardian-key

# ─── Twilio (PRE-06) ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
