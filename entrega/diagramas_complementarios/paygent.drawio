n/evaluate · /score&lt;br&gt;&lt;br&gt;rules.py decide: velocidad,&lt;br&gt;comercio nuevo, vales viejos&lt;br&gt;solo puede restringir&lt;br&gt;el LLM solo redacta el porqué&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;strokeColor=#c2362b;fillColor=#f8e4e1;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;verticalAlign=middle;verticalAlign=top;spacingTop=16;" vertex="1" parent="c4"><mxGeometry x="540" y="520" width="480" height="330" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;intent/&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#626368&quot;&gt;POST /intent/compile&lt;br&gt;&lt;br&gt;&quot;hasta $300 al mes para mi mamá…&quot;&lt;br&gt;→ árbol de mandatos propuesto&lt;br&gt;el titular aprueba en su wallet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;strokeColor=#5a3e9e;fillColor=#ece6f5;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;verticalAlign=middle;verticalAlign=top;spacingTop=16;" vertex="1" parent="c4"><mxGeometry x="30" y="520" width="480" height="330" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;common/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#626368&quot;&gt;api_client.py (x-api-key + x-agent-id) · config.py · merchants.py · money.py (from_cop)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;strokeColor=#626368;fillColor=#fdfdfc;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;verticalAlign=middle;" vertex="1" parent="c4"><mxGeometry x="30" y="890" width="1500" height="110" as="geometry"/></mxCell><mxCell id="c18" value="&lt;font style=&quot;font-size:13px;color:#626368&quot;&gt;Pydantic v2 · type hints · pytest · uv&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;strokeColor=#626368;fillColor=#fdfdfc;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;verticalAlign=middle;dashed=1;" vertex="1" parent="c4"><mxGeometry x="30" y="1040" width="1