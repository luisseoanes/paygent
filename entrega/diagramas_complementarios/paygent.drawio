istra sus rutas · el gateway es el único que decide si un pago sale" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#626368;fontFamily=Helvetica;fontSize=19;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="2200" height="34" as="geometry"/></mxCell><mxCell id="c4" value="Fastify · app.ts (CORS, formbody, errores HttpError)" style="swimlane;startSize=36;rounded=1;arcSize=3;html=1;whiteSpace=wrap;strokeWidth=2;strokeColor=#626368;fillColor=#fdfdfc;swimlaneFillColor=#f3f2ee;fontStyle=1;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1500" height="1140" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;gateway/&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#626368&quot;&gt;POST /pay · POST /mandates/:id/delegate&lt;br&gt;/revoke · /unfreeze · /device-key · /beneficiaries&lt;br&gt;GET /mandates/:id · /tree · PUT/DELETE /sms&lt;br&gt;POST /agents · GET /merchants · /gateway/public-key&lt;br&gt;&lt;b&gt;authorize.ts&lt;/b&gt; motor de reglas · &lt;b&gt;pin.ts&lt;/b&gt;&lt;br&gt;&lt;b&gt;payout.ts&lt;/b&gt; Puntored · &lt;b&gt;keys.ts&lt;/b&gt; ed25519&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;strokeColor=#1f3fae;fillColor=#e3e8f7;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;verticalAlign=middle;verticalAlign=top;spacingTop=14;align=left;spacingLeft=20;" vertex="1" parent="c4"><mxGeometry x="30" y="60" width="700" height="260" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;op/&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#626368&quot;&gt;POST /mandates/root (pide el grant)&lt;br&gt;GET /callback/:rootId (continúa el grant)&lt;br&gt;GET /health/op&lt;br&gt;&lt;b&gt;client.ts&lt;/b&gt; cliente autenticado (llave del cliente)&lt;br&gt;&lt;b&gt;grants.ts&lt;/b&gt; GNAP interactivo y no interactivo&lt;br&gt;&lt;b&gt;settle.ts&lt;/b&gt; incoming → quote → outgoin