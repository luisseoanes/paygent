elvetica;fontSize=14;exitX=1;exitY=0.37;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#626368;fontColor=#1f1f22;labelBackgroundColor=#f3f2ee;fontFamily=Helvetica;fontSize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c14" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;Las 5 reglas viven en el gateway, con tests:&lt;/b&gt;&lt;br&gt;1 · un agente es una hoja: no pasa su rama&lt;br&gt;2 · los permisos solo se achican&lt;br&gt;3 · sobre el umbral, PIN&lt;br&gt;4 · cada pago es un Outgoing Payment real&lt;br&gt;5 · todo queda en la libreta con su porqué" style="shape=note;whiteSpace=wrap;html=1;size=16;strokeColor=#c2362b;fillColor=#f8e4e1;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1700" y="1190" width="660" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="Datos y contrato"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1220" background="#f3f2ee" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Datos y contrato" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=34;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="2000" height="56" as="geometry"/></mxCell><mxCell id="c3" value="Postgres (store/migrations.ts) · un cambio de esquema = una migración nueva · src/shared es el contrato entre gateway y navegador" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#626368;fontFamily=Helvetica;fontSize=19;" vertex="1" parent="1"><mxGeometry x="40" y="66"