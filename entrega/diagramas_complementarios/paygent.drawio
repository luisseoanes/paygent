e)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeWidth=1.5;strokeColor=#5a3e9e;fillColor=#ece6f5;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=18;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="940" width="460" height="140" as="geometry" /></mxCell><mxCell id="c11" value="&lt;b&gt;Agente Guardián&lt;/b&gt;&lt;br&gt;$0 · solo restringe:&lt;br&gt;congela, baja topes, explica" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeWidth=1.5;strokeColor=#c2362b;fillColor=#f8e4e1;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1460" y="400" width="460" height="150" as="geometry" /></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#1f1f22;fontColor=#1f1f22;labelBackgroundColor=#f3f2ee;fontFamily=Helvetica;fontSize=18;fontSize=15;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#1f1f22;fontColor=#1f1f22;labelBackgroundColor=#f3f2ee;fontFamily=Helvetica;fontSize=18;fontSize=15;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#1f1f22;fontColor=#1f1f22;labelBackgroundColor=#f3f2ee;fontFamily=Helvetica;fontSize=18;fontSize=15;" edge="1" parent="1" source="c5" target="c11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#1f1f22;fontColor=#1f1f22;labelBackgroundColor=#f3f2ee;fontFamily=Helvetica;fontSize=18;fontSize=15;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c16" value=""