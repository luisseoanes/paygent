<mxfile host="paygent" type="device"><diagram id="p0" name="Vista general"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1560" background="#f3f2ee" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Paygent · vista general" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=34;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="2000" height="56" as="geometry"/></mxCell><mxCell id="c3" value="Un mandato raíz por titular → ramas para personas, celulares y agentes → cada pago es un Outgoing Payment real, directo de la wallet del titular al destinatario" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#626368;fontFamily=Helvetica;fontSize=19;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="2200" height="34" as="geometry"/></mxCell><mxCell id="c4" value="Titular (Juan)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;strokeWidth=2;strokeColor=#1f3fae;fillColor=#e3e8f7;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="40" height="70" as="geometry"/></mxCell><mxCell id="c5" value="Beneficiaria (María)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;strokeWidth=2;strokeColor=#1e7a4c;fillColor=#e2f0e7;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="600" y="130" width="40" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Tendero" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;strokeWidth=2;strokeColor=#8a5a12;fillColor=#f6ebd6;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="900" y="130" width="40" height="70" as="geometry"/></mxCell><mxCell id="c7" value="Persona con celular&lt;br&gt;de teclas (Doña Rosa)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;strokeWidth=2;strokeColor=#5a3e9e;fillColor=#ece6f5;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="120" y="340" width="40" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Telnyx&lt;/b&gt; (SMS)&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#626368&quot;&gt;o puente adb con un Android&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;strokeColor=#5a3e9e;fillColor=#ece6f5;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="300" height="90" as="geometry"/></mxCell><mxCell id="c9" value="Railway · producción · paygent.up.railway.app" style="swimlane;startSize=36;rounded=1;arcSize=3;html=1;whiteSpace=wrap;strokeWidth=2;strokeColor=#626368;fillColor=#fdfdfc;swimlaneFillColor=#f3f2ee;fontStyle=1;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;fontSize=18;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="1440" height="980" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Frontend · web&lt;/b&gt;&lt;br&gt;React 19 + Vite · PWA con service worker&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#626368&quot;&gt;/cuenta · /billetera · /tendero · /celular · /enlazar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;strokeColor=#1f3fae;fillColor=#e3e8f7;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;verticalAlign=middle;" vertex="1" parent="c9"><mxGeometry x="40" y="60" width="640" height="120" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Proxy de la web&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#626368&quot;&gt;/api/* → api · /agents/* → agents&lt;br&gt;red privada *.railway.internal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;strokeColor=#626368;fillColor=#fdfdfc;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;verticalAlign=middle;dashed=1;" vertex="1" parent="c9"><mxGeometry x="760" y="60" width="620" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Backend · api&lt;/b&gt; (Fastify, TypeScript)&lt;br&gt;&lt;br&gt;&lt;b&gt;gateway&lt;/b&gt; decide cada pago: topes, categorías, PIN&lt;br&gt;&lt;b&gt;op&lt;/b&gt; cliente de Open Payments&lt;br&gt;&lt;b&gt;vouchers&lt;/b&gt; cobra vales firmados sin señal&lt;br&gt;&lt;b&gt;sms&lt;/b&gt; canal SMS · &lt;b&gt;feed&lt;/b&gt; libreta en vivo (SSE)&lt;br&gt;&lt;b&gt;auth&lt;/b&gt; cuentas · &lt;b&gt;chat&lt;/b&gt; asistente en la app" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;strokeColor=#1f3fae;fillColor=#e3e8f7;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;verticalAlign=middle;align=left;spacingLeft=24;" vertex="1" parent="c9"><mxGeometry x="40" y="290" width="640" height="330" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Agentes&lt;/b&gt; (FastAPI, Python)&lt;br&gt;&lt;br&gt;&lt;b&gt;Asistente&lt;/b&gt; entiende el pedido y propone&lt;br&gt;&lt;b&gt;Inventario&lt;/b&gt; qué tienda tiene qué · cobra por consulta&lt;br&gt;&lt;b&gt;Guardián&lt;/b&gt; solo restringe · reglas deterministas&lt;br&gt;&lt;b&gt;Intención&lt;/b&gt; texto del titular → árbol" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;strokeColor=#5a3e9e;fillColor=#ece6f5;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;verticalAlign=middle;align=left;spacingLeft=24;" vertex="1" parent="c9"><mxGeometry x="760" y="290" width="620" height="330" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Postgres&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#626368&quot;&gt;mandatos · pagos · vales · libreta&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=16;strokeWidth=1.5;strokeColor=#626368;fillColor=#fdfdfc;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="c9"><mxGeometry x="40" y="760" width="300" height="160" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;@openroute/shared&lt;/b&gt; · el contrato&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#626368&quot;&gt;tipos, montos y firma ed25519 de vales,&lt;br&gt;idéntica en el gateway y en el navegador&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;strokeColor=#626368;fillColor=#fdfdfc;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;verticalAlign=middle;dashed=1;" vertex="1" parent="c9"><mxGeometry x="420" y="760" width="420" height="160" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;El gateway decide, nunca el modelo.&lt;/b&gt;&lt;br&gt;Los agentes no tienen llaves ni fondos: proponen y llaman a /pay como cualquier otro." style="shape=note;whiteSpace=wrap;html=1;size=16;strokeColor=#c2362b;fillColor=#f8e4e1;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="c9"><mxGeometry x="920" y="760" width="460" height="160" as="geometry"/></mxCell><mxCell id="c17" value="Open Payments · Interledger (red de prueba)" style="swimlane;startSize=36;rounded=1;arcSize=3;html=1;whiteSpace=wrap;strokeWidth=2;strokeColor=#1f3fae;fillColor=#e3e8f7;swimlaneFillColor=#f3f2ee;fontStyle=1;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1960" y="300" width="400" height="620" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Auth server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#626368&quot;&gt;grants GNAP · consentimiento&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;strokeColor=#1f3fae;fillColor=#e3e8f7;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;verticalAlign=middle;" vertex="1" parent="c17"><mxGeometry x="30" y="60" width="340" height="100" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Wallet del titular&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#626368&quot;&gt;de aquí sale cada pago&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;strokeColor=#1f3fae;fillColor=#e3e8f7;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;verticalAlign=middle;" vertex="1" parent="c17"><mxGeometry x="30" y="190" width="340" height="100" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Wallets de las tiendas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#626368&quot;&gt;incoming payments&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;strokeColor=#1e7a4c;fillColor=#e2f0e7;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;verticalAlign=middle;" vertex="1" parent="c17"><mxGeometry x="30" y="320" width="340" height="100" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Wallet de Puntored&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#626368&quot;&gt;tenderos sin wallet: llave Bre-B&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;strokeColor=#8a5a12;fillColor=#f6ebd6;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;verticalAlign=middle;" vertex="1" parent="c17"><mxGeometry x="30" y="450" width="340" height="100" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Anthropic Claude&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#626368&quot;&gt;si falla o tarda: reglas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;strokeColor=#5a3e9e;fillColor=#ece6f5;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1960" y="1000" width="400" height="100" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;OpenStreetMap · Overpass&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#626368&quot;&gt;tiendas cercanas reales&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;strokeColor=#626368;fillColor=#fdfdfc;fontColor=#1f1f22;fontFamily=Helvetica;fontSize=16;verticalAlign=middle;" vertex="1" parent=