{
  "name": "@paygent/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint src --fix --cache --cache-location node_modules/.cache/eslint/ && prettier --write --cache --log-level warn src",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache --log-level warn src",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "validate": "npm run check-types && npm run lint && npm run format:check && npm run test:run",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@hookform/resolvers": "^5.2.0",
    "@openroute/shared": "file:../shared",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.80.0",
    "@tanstack/react-query-devtools": "^5.80.0",
    "axios": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^1.0.0",
    "motion": "^14.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.60.0",
    "react-router": "^7.7.0",
    "tailwind-merge": "^3.3.0",
    "tweetnacl": "^1.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/eslint-plugin": "^1.3.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-import-resolver-typescript": "^4.4.0",
    "eslint-plugin-check-file": "^3.3.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-testing-library": "^7.5.0",
    "globals": "^16.3.0",
    "husky": "^9.1.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.0",
    "msw": "^2.10.0",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --cache --cache-location node_modules/.cache/eslint/",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
