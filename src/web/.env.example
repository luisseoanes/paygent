# Every variable must start with VITE_APP_ and be declared in src/config/env.ts
# /api pasa por el proxy de Vite hacia src/api. Con mocking=true responde MSW en vez de la api real.
VITE_APP_API_URL=/api
VITE_APP_ENABLE_API_MOCKING=false
# Opcional: la wallet de Juan que se muestra en /juan (la misma que WALLET_JUAN de apps/api)
# VITE_APP_JUAN_WALLET_ADDRESS=https://ilp.interledger-test.dev/juan
# Opcional: número del puente SMS (pnpm sms:bridge). Activa "Cobrar por SMS" en los vales pendientes del tendero.
# VITE_APP_SMS_GATEWAY_NUMBER=+573001234567
