# Every variable must start with VITE_APP_ and be declared in src/config/env.ts
# apps/api corre en el puerto 3001 (backlog §2.2). Con mocking=true responde MSW.
VITE_APP_API_URL=http://localhost:3001
VITE_APP_ENABLE_API_MOCKING=true
# Opcional: la wallet de Juan que se muestra en /juan (la misma que WALLET_JUAN de apps/api)
# VITE_APP_JUAN_WALLET_ADDRESS=https://ilp.interledger-test.dev/juan
