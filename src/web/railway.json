{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @paygent/web build",
    "watchPatterns": ["/src/web/**", "/src/shared/**", "/pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @paygent/web start"
  }
}
